{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=PLACEHOLDER_HOST;Port=5432;Database=postgres;Username=postgres.PLACEHOLDER_REF;Password=PLACEHOLDER_PASS;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Issuer": "AegisBackendApi",
    "Audience": "AegisFrontendApp",
    "Key": "AegisDevSecretKeyForJwtAuthenticationMustBeAtLeast32BytesLong!",
    "ExpiryMinutes": 15
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:3000"
  }
}
