# AEGIS Environment Variables Example
# Set your Supabase Session Pooler connection string in dotnet user-secrets:
# dotnet user-secrets set "ConnectionStrings:Default" "Host=<pooler-host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<your-db-password>;SSL Mode=Require;Trust Server Certificate=true" --project src/Aegis.Api

ConnectionStrings__Default=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.yourprojectref;Password=yourpassword;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=AegisDevSecretKeyForJwtAuthenticationMustBeAtLeast32BytesLong!
Jwt__Issuer=AegisBackendApi
Jwt__Audience=AegisFrontendApp
Cors__FrontendOrigin=http://localhost:3000
